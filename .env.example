# Database (ODBC connection string for msnodesqlv8)
# Example: Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=AuctionDB;Trusted_Connection=yes;TrustServerCertificate=yes;
CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=AuctionDB;Trusted_Connection=yes;TrustServerCertificate=yes;"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Server
PORT=3000
HOST=localhost
