# ============================================
# HỆ THỐNG ĐẤU GIÁ - CẤU HÌNH MÔI TRƯỜNG
# ============================================
# Sao chép tệp này thành .env và cập nhật các giá trị cho môi trường của bạn

# ============================================
# Cấu Hình Máy Chủ
# ============================================
NODE_ENV=development
PORT=5200
PUBLIC_URL=https://preaccommodatingly-outlying-aurelio.ngrok-free.dev
LOG_LEVEL=INFO

# ============================================
# Cơ Sở Dữ Liệu (MySQL)
# Sử dụng Laragon hoặc MySQL 8.0+
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=AuctionWebsite
DB_USER=root
DB_PASSWORD=
DB_POOL_LIMIT=10

# ============================================
# JWT & Xác Thực
# ============================================
JWT_SECRET=Whiskeyesc
JWT_EXPIRES_IN=24h
SESSION_SECRET=Euphoria

# ============================================
# Redis Cache
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Email (Gmail SMTP)
# ============================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@auction.local

# ============================================
# Cổng Thanh Toán (Momo)
# ============================================
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=klm05TvNBzhg7h7j
MOMO_SECRET_KEY=at67qH6mk8w5Y1nAyMoYKMWACiEi2bsa
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ============================================
# OAuth (Google)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# OAuth (Facebook)
# ============================================
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ============================================
# Tải Tệp
# LƯỚI ĐỠ: Hình ảnh hiện được lưu trữ trong cơ sở dữ liệu (LONGBLOB)
# không phải trong thư mục uploads/
# ============================================
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif
UPLOAD_DIR=./uploads

# ============================================
# Phiên (Session)
# ============================================
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true

# ============================================
# Ghi Chú Quan Trọng
# ============================================
# 1. Để khởi chạy: npm run dev
# 2. Nhập schema từ AuctionWebsite.sql vào MySQL
# 3. Đổi DB_PASSWORD nếu cần (mặc định là trống cho root)
# 4. Tất cả hình ảnh được lưu vào database, không phải file
